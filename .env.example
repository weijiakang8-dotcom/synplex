# Example only; this file is NOT loaded automatically. Export selected values.
# Use a new private directory; never copy another user's connection.json.
SYNPLEX_WORKSPACE_DATA_DIR=/absolute/path/to/private-workspace
SYNPLEX_WORKSPACE_PORT=5200
SYNPLEX_WORKSPACE_SERVE_UI=1
# Optional exact initial project scope (not a wildcard):
SYNPLEX_WORKSPACE_SCOPE={"projectId":"local-project","versionId":null,"branchId":null}
# Model credentials belong in private engine configuration, not frontend code.
