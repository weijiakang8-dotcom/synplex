  {
    "name": "prepare_task",
    "title": "准备任务",
    "description": "整理任务目标、交付要求和参考资料，只准备说明，不开始执行。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "const": "synplex.workspace/1.0.0"
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "expectedStateRevision": {
          "type": "integer",
          "minimum": 0
        },
        "goal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16000
          }
        },
        "acceptanceCriteria": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16000
          },
          "minItems": 1
        },
        "mode": {
          "enum": [
            "host_assist",
            "platform_owned",
            "delegated"
          ]
        },
        "executor": {
          "enum": [
            "current_host",
            "synplex",
            "codex",
            "dsh"
          ]
        },
        "selectedOccurrenceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "maxInputTokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "executionOptions": {
          "$ref": "#/$defs/ExecutionOptions"
        }
      },
      "required": [
        "protocolVersion",
        "requestId",
        "scope",
        "expectedStateRevision",
        "goal",
        "constraints",
        "acceptanceCriteria",
        "mode",
        "executor",
        "selectedOccurrenceIds",
        "maxInputTokens"
      ],
      "additionalProperties": false,
      "$defs": {
        "Scope": {
          "type": "object",
          "properties": {
            "projectId": {
              "type": "string",
              "minLength": 1
            },
            "versionId": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "branchId": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "projectId",
            "versionId",
            "branchId"
          ],
          "additionalProperties": false
        },
        "ExecutionOptions": {
          "type": "object",
          "properties": {
            "model": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "effort": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32
            }
          },
          "required": [
            "model",
            "effort"
          ],
          "additionalProperties": false
        }
      }
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "record_result",
    "title": "保存成果",
    "description": "保存当前工具完成的结果；是否符合要求，仍需用户检查。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "const": "synplex.workspace/1.0.0"
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "expectedStateRevision": {
          "type": "integer",
          "minimum": 0
        },
        "runId": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "$ref": "#/$defs/ResultInput"
        }
      },
      "required": [
        "protocolVersion",
        "requestId",
        "scope",
        "expectedStateRevision",
        "runId",
        "result"
      ],
      "additionalProperties": false,
      "$defs": {
        "Scope": {
          "type": "object",
          "properties": {
            "projectId": {
              "type": "string",
              "minLength": 1
            },
            "versionId": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "branchId": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "projectId",
            "versionId",
            "branchId"
          ],
          "additionalProperties": false
        },
        "ResultInput": {
          "type": "object",
          "properties": {
            "eventId": {
              "type": "string",
              "minLength": 1
            },
            "attemptId": {
              "type": "string",
              "minLength": 1
            },
            "provider": {
              "type": "string",
              "minLength": 1
            },
            "summary": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32000
            },
            "artifacts": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Artifact"
              }
            },
            "checks": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Check"
              }
            },
            "usage": {
              "$ref": "#/$defs/Usage"
            },
            "supersedesResultId": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "occurredAt": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "eventId",
            "attemptId",
            "provider",
            "summary",
            "artifacts",
            "checks",
            "usage",
            "supersedesResultId",
            "occurredAt"
          ],
          "additionalProperties": false
        },
        "Artifact": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "uri": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "byteLength": {
              "type": "integer",
              "minimum": 0
            },
            "mediaType": {
              "type": "string",
              "minLength": 1
            },
            "verification": {
              "enum": [
                "reported",
                "hash_verified",
                "unavailable"
              ]
            }
          },
          "required": [
            "id",
            "name",
            "uri",
            "sha256",
            "byteLength",
            "mediaType",
            "verification"
          ],
          "additionalProperties": false
        },
        "Check": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "method": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "enum": [
                "passed",
                "failed",
                "not_run",
                "unknown"
              ]
            },
            "artifactIds": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "evidence": {
              "type": "string",
              "minLength": 1
            },
            "performedBy": {
              "type": "string",
              "minLength": 1
            },
            "recordedAt": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "id",
            "method",
            "status",
            "artifactIds",
            "evidence",
            "performedBy",
            "recordedAt"
          ],
          "additionalProperties": false
        },
        "Usage": {
          "type": "object",
          "properties": {
            "observationScope": {
              "enum": [
                "preparation_only",
                "attempt",
                "run",
                "host_unavailable"
              ]
            },
            "provider": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "model": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "inputTokens": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "outputTokens": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "cachedInputTokens": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "costUsd": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "pricingRevision": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "provenance": {
              "enum": [
                "no_model_call",
                "provider_receipt",
                "invoice",
                "estimate",
                "unknown"
              ]
            }
          },
          "required": [
            "observationScope",
            "provider",
            "model",
            "inputTokens",
            "outputTokens",
            "cachedInputTokens",
            "costUsd",
            "pricingRevision",
            "provenance"
          ],
          "additionalProperties": false
        }
      }
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "propose_lesson",
    "title": "保存经验",
    "description": "保存有出处的经验，等待用户确认。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "const": "synplex.workspace/1.0.0"
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "expectedStateRevision": {
          "type": "integer",
          "minimum": 0
        },
        "candidate": {
          "$ref": "#/$defs/CandidateInput"
        }
      },
      "required": [
        "protocolVersion",
        "requestId",
        "scope",
        "expectedStateRevision",
        "candidate"
      ],
      "additionalProperties": false,
      "$defs": {
        "Scope": {
          "type": "object",
          "properties": {
            "projectId": {
              "type": "string",
              "minLength": 1
            },
            "versionId": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "branchId": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "projectId",
            "versionId",
            "branchId"
          ],
          "additionalProperties": false
        },
        "CandidateInput": {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "fact",
                "decision",
                "failure",
                "lesson",
                "unknown"
              ]
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "body": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16000
            },
            "evidenceKind": {
              "enum": [
                "user_statement",
                "assistant_statement",
                "historical_tool_text",
                "direct_tool_receipt",
                "independent_check"
              ]
            },
            "evidence": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/EvidenceSpan"
              }
            },
            "occurredAt": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ]
            },
            "supersedes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "condition": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "type",
            "title",
            "body",
            "evidenceKind",
            "evidence",
            "occurredAt",
            "supersedes",
            "condition"
          ],
          "additionalProperties": false
        },
        "EvidenceSpan": {
          "type": "object",
          "properties": {
            "sourceId": {
              "type": "string",
              "minLength": 1
            },
            "parsedRevisionId": {
              "type": "string",
              "minLength": 1
            },
            "occurrenceId": {
              "type": "string",
              "minLength": 1
            },
            "blockId": {
              "type": "string",
              "minLength": 1
            },
            "start": {
              "type": "integer",
              "minimum": 0
            },
            "end": {
              "type": "integer",
              "minimum": 0
            },
            "offsetUnit": {
              "const": "utf16_code_unit"
            },
            "quote": {
              "type": "string"
            },
            "quoteHash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "sourceId",
            "parsedRevisionId",
            "occurrenceId",
            "blockId",
            "start",
            "end",
            "offsetUnit",
            "quote",
            "quoteHash"
          ],
          "additionalProperties": false
        }
      }
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
