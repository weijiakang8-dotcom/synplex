[
  {
    "name": "get_project_state",
    "title": "查看项目进展",
    "description": "查看项目进展、待确认的记录和过去的重要决定。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "const": "synplex.workspace/1.0.0"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        }
      },
      "required": [
        "protocolVersion",
        "scope"
      ],
      "additionalProperties": false,
      "$defs": {
        "Scope": {
          "type": "object",
          "properties": {
            "projectId": {
              "type": "string",
              "minLength": 1
            },
            "versionId": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "branchId": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "projectId",
            "versionId",
            "branchId"
          ],
          "additionalProperties": false
        }
      }
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
