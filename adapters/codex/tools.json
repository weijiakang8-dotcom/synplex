          "type": "object",
          "properties": {
            "projectId": {
              "type": "string",
              "minLength": 1
            },
            "versionId": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "branchId": {
              "anyOf": [
                {
                  "type": "string",
